---
import Button from "@/components/Button.astro";

const videoSource = "https://videos.pexels.com/video-files/8964727/8964727-hd_1920_1080_25fps.mp4";
const poster = "https://images.pexels.com/videos/8964379/adult-architect-blueprint-building-8964379.jpeg?auto=compress&dpr=1&h=1200&w=1920";

const stages = [
  { number: "01", label: "PLANNING", title: "Start with a clear plan.", description: "We review your needs, drawings, scope, budget, and timeline before work begins.", image: "https://images.pexels.com/videos/8964379/adult-architect-blueprint-building-8964379.jpeg?auto=compress&dpr=1&h=750&w=1260" },
  { number: "02", label: "SITE PREPARATION", title: "Prepare the ground properly.", description: "Surveying, excavation, materials, access, safety, and site coordination are put in place.", image: "https://images.pexels.com/photos/37636298/pexels-photo-37636298/free-photo-of-construction-site-with-workers-and-excavator.jpeg?auto=compress&dpr=1&h=750&w=1260" },
  { number: "03", label: "BUILDING", title: "Build with strength and care.", description: "Our teams handle the structural work and construction stages with close attention to quality.", image: "https://images.pexels.com/photos/11680715/pexels-photo-11680715.jpeg?auto=compress&dpr=1&w=1260" },
  { number: "04", label: "PROJECT MANAGEMENT", title: "Keep every part moving together.", description: "We coordinate people, materials, schedules, inspections, and site progress from start to finish.", image: "https://images.pexels.com/photos/32858871/pexels-photo-32858871.jpeg?auto=compress&dpr=1&w=1260" },
  { number: "05", label: "HANDOVER", title: "Finish ready for use.", description: "Final checks, finishing details, cleaning, and handover complete the project.", image: "https://images.pexels.com/photos/32858871/pexels-photo-32858871.jpeg?auto=compress&dpr=1&w=1260" },
];

const jsonStages = JSON.stringify(stages);
---

<section class="construction-film relative bg-slate-950 text-white" data-construction-film data-stages={jsonStages}>
  <div class="construction-film__top-fade pointer-events-none absolute inset-x-0 top-0 z-20 h-28"></div>

  <div class="construction-film__pin relative min-h-[100svh] overflow-hidden">
    <div class="absolute inset-0 bg-slate-950">
      <img class="construction-film__poster absolute inset-0 h-full w-full object-cover object-center" src={poster} alt="Construction planning and site work" loading="eager" decoding="async" />
      <video class="construction-film__video absolute inset-0 h-full w-full object-cover object-center opacity-0" playsinline muted autoplay loop preload="auto" aria-hidden="true" disablepictureinpicture src={videoSource} poster={poster}></video>
      <div class="absolute inset-0 bg-black/28"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/82 via-slate-950/42 to-slate-950/12"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/72 via-transparent to-slate-950/18"></div>
    </div>

    <div class="construction-film__content container relative z-10 flex min-h-[100svh] items-center py-20 md:py-24 lg:py-28">
      <div class="grid w-full grid-cols-1 items-center gap-8 lg:grid-cols-[minmax(0,1fr)_420px] lg:gap-16">
        <div class="construction-film__intro max-w-3xl">
          <div class="text-primary inline-flex items-center gap-3 text-xs font-bold tracking-[0.24em] uppercase"><span class="h-px w-10 bg-primary"></span>The SuperBuild Way</div>
          <h2 class="mt-5 text-4xl leading-[1.05] font-semibold tracking-tight text-white md:text-6xl lg:text-7xl">From planning to handover.</h2>
          <p class="mt-6 max-w-2xl text-base leading-7 text-white/90 md:text-lg md:leading-8">A clear construction process, carefully coordinated from the first plan to the final handover.</p>
          <div class="mt-8 flex flex-wrap items-center gap-3 md:mt-9 md:gap-4"><Button label="Talk to SuperBuild" url="/#contact" enable={true} /><span class="rounded-full border border-white/15 bg-black/20 px-4 py-2 text-sm text-white/70 backdrop-blur-sm">Scroll through the five stages</span></div>
        </div>

        <div class="construction-film__stage-panel rounded-3xl border border-white/14 bg-slate-950/72 p-3 shadow-2xl shadow-black/30 backdrop-blur-xl md:p-5">
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/5">
            <img class="construction-film__stage-image h-52 w-full object-cover md:h-64" src={stages[0].image} alt="Construction planning" loading="eager" decoding="async" />
          </div>
          <div class="p-2 pt-4 md:p-3 md:pt-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="construction-film__stage-number text-primary text-3xl font-semibold leading-none">01</div>
                <div class="construction-film__stage-label mt-2 text-[11px] font-bold tracking-[0.2em] text-white/75 uppercase">Planning</div>
              </div>
              <div class="pt-1 text-[11px] font-medium tracking-[0.16em] text-white/50 uppercase">01 — 05</div>
            </div>
            <h3 class="construction-film__stage-title mt-4 text-2xl font-semibold text-white">Start with a clear plan.</h3>
            <p class="construction-film__stage-description mt-3 text-sm leading-6 text-white/82">We review your needs, drawings, scope, budget, and timeline before work begins.</p>
            <div class="mt-6 flex gap-2" aria-hidden="true">{stages.map((stage, index) => <span class:list={["construction-film__progress-dot h-1.5 flex-1 rounded-full bg-white/20 transition-all duration-300", index === 0 && "!bg-primary"]} data-stage-dot={index}></span>)}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="pointer-events-none absolute right-4 bottom-5 left-4 z-10 md:right-10 md:bottom-8 md:left-10">
      <div class="mx-auto max-w-7xl">
        <div class="flex items-center gap-4"><span class="text-[10px] font-bold tracking-[0.24em] text-white/60 uppercase">Scroll</span><div class="h-px flex-1 bg-white/20"><i class="construction-film__rail bg-primary block h-px origin-left" style="transform:scaleX(0)"></i></div></div>
      </div>
    </div>
  </div>

  <div class="construction-film__bottom-fade pointer-events-none absolute inset-x-0 bottom-0 z-20 h-32"></div>
</section>

<script>
  const install = () => {
    document.querySelectorAll<HTMLElement>("[data-construction-film]").forEach((section) => {
      if (section.dataset.constructionFilmReady !== undefined) return;
      section.dataset.constructionFilmReady = "";

      const video = section.querySelector<HTMLVideoElement>(".construction-film__video");
      const poster = section.querySelector<HTMLImageElement>(".construction-film__poster");
      const rail = section.querySelector<HTMLElement>(".construction-film__rail");
      const panel = section.querySelector<HTMLElement>(".construction-film__stage-panel");
      const intro = section.querySelector<HTMLElement>(".construction-film__intro");
      const stageNumber = section.querySelector<HTMLElement>(".construction-film__stage-number");
      const stageLabel = section.querySelector<HTMLElement>(".construction-film__stage-label");
      const stageTitle = section.querySelector<HTMLElement>(".construction-film__stage-title");
      const stageDescription = section.querySelector<HTMLElement>(".construction-film__stage-description");
      const stageImage = section.querySelector<HTMLImageElement>(".construction-film__stage-image");
      const dots = [...section.querySelectorAll<HTMLElement>("[data-stage-dot]")];
      const stages = JSON.parse(section.dataset.stages || "[]") as Array<{number:string;label:string;title:string;description:string;image:string}>;
      if (!video || !poster || !rail || !panel || !intro || !stageNumber || !stageLabel || !stageTitle || !stageDescription || !stageImage) return;

      let raf = 0;
      let lastStage = -1;
      const clamp = (value:number) => Math.min(1, Math.max(0, value));

      const ensureVideoPlayback = () => {
        video.play().then(() => {
          video.classList.add("opacity-100");
          poster.classList.add("opacity-0");
        }).catch(() => {
          video.classList.remove("opacity-100");
          poster.classList.remove("opacity-0");
        });
      };

      const preloadStageImages = () => {
        stages.slice(1).forEach((stage) => {
          const image = new Image();
          image.src = stage.image;
        });
      };

      const setStage = (index:number) => {
        if (index === lastStage || !stages[index]) return;
        lastStage = index;
        const stage = stages[index];
        stageNumber.textContent = stage.number;
        stageLabel.textContent = stage.label;
        stageTitle.textContent = stage.title;
        stageDescription.textContent = stage.description;
        stageImage.style.opacity = "0.2";
        stageImage.src = stage.image;
        stageImage.animate([{opacity:0.2,transform:"scale(1.025)"},{opacity:1,transform:"scale(1)"}], {duration:450,easing:"cubic-bezier(.22,1,.36,1)"});
        dots.forEach((dot,i)=>dot.classList.toggle("!bg-primary", i===index));
      };

      const update = () => {
        const rect = section.getBoundingClientRect();
        const travel = Math.max(section.offsetHeight - window.innerHeight, 1);
        const progress = clamp(-rect.top / travel);
        const index = Math.min(stages.length - 1, Math.floor(progress * stages.length));
        setStage(index);
        rail.style.transform = `scaleX(${progress})`;
      };

      const requestUpdate = () => {
        if (raf) return;
        raf = requestAnimationFrame(() => { raf = 0; update(); });
      };

      const reveal = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          intro.classList.add("is-visible");
          panel.classList.add("is-visible");
          preloadStageImages();
          ensureVideoPlayback();
          reveal.disconnect();
        }
      }, { threshold: 0.1 });

      reveal.observe(section);
      video.addEventListener("loadeddata", ensureVideoPlayback, { once: true });
      video.addEventListener("canplay", ensureVideoPlayback, { once: true });
      video.addEventListener("error", () => { video.classList.remove("opacity-100"); poster.classList.remove("opacity-0"); });
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
      ensureVideoPlayback();
      requestUpdate();
    });
  };

  document.addEventListener("astro:page-load", install);
  install();
</script>

<style>
  .construction-film {
    position: relative;
    min-height: 500svh;
    isolation: isolate;
  }

  .construction-film__pin {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  .construction-film__poster,
  .construction-film__video {
    transition: opacity 800ms ease;
  }

  .construction-film__top-fade {
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.9), transparent);
  }

  .construction-film__bottom-fade {
    background: linear-gradient(to top, rgb(255 255 255 / 0.95), transparent);
  }

  .construction-film__intro,
  .construction-film__stage-panel {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 850ms ease, transform 850ms cubic-bezier(.22,1,.36,1);
  }

  .construction-film__stage-panel {
    transform: translateY(38px) scale(.985);
    transition-delay: 120ms;
  }

  .construction-film__intro.is-visible,
  .construction-film__stage-panel.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .construction-film__rail {
    width: 100%;
    transform-origin: left;
    transition: transform 120ms linear;
  }

  @media (max-width: 767px) {
    .construction-film {
      min-height: 500svh;
    }

    .construction-film__top-fade,
    .construction-film__bottom-fade {
      height: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .construction-film {
      min-height: 100svh;
    }

    .construction-film__pin {
      position: relative;
    }

    .construction-film__intro,
    .construction-film__stage-panel {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
