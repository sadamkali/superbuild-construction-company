---
import Button from "@/components/Button.astro";

const videoSource =
  "https://videos.pexels.com/video-files/8964727/8964727-uhd_3840_2160_25fps.mp4";
const poster =
  "https://images.pexels.com/videos/8964379/adult-architect-blueprint-building-8964379.jpeg?auto=compress&dpr=1&h=1200&w=1920";

const stages = [
  {
    number: "01",
    label: "PLANNING",
    title: "Start with a clear plan.",
    description: "We review your needs, drawings, scope, budget, and timeline before work begins.",
    image:
      "https://images.pexels.com/videos/8964379/adult-architect-blueprint-building-8964379.jpeg?auto=compress&dpr=1&h=750&w=1260",
  },
  {
    number: "02",
    label: "SITE PREPARATION",
    title: "Prepare the ground properly.",
    description: "Surveying, excavation, materials, access, safety, and site coordination are put in place.",
    image:
      "https://images.pexels.com/photos/37636298/pexels-photo-37636298/free-photo-of-construction-site-with-workers-and-excavator.jpeg?auto=compress&dpr=1&h=750&w=1260",
  },
  {
    number: "03",
    label: "BUILDING",
    title: "Build with strength and care.",
    description: "Our teams handle the structural work and construction stages with close attention to quality.",
    image:
      "https://images.pexels.com/photos/11680715/pexels-photo-11680715.jpeg?auto=compress&dpr=1&w=1260",
  },
  {
    number: "04",
    label: "PROJECT MANAGEMENT",
    title: "Keep every part moving together.",
    description: "We coordinate people, materials, schedules, inspections, and site progress from start to finish.",
    image:
      "https://images.pexels.com/videos/8964379/adult-architect-blueprint-building-8964379.jpeg?auto=compress&dpr=1&h=750&w=1260",
  },
  {
    number: "05",
    label: "HANDOVER",
    title: "Finish ready for use.",
    description: "Final checks, finishing details, cleaning, and handover complete the project.",
    image:
      "https://images.pexels.com/photos/32858871/pexels-photo-32858871.jpeg?auto=compress&dpr=1&w=1260",
  },
];

const jsonStages = JSON.stringify(stages);
---

<section
  class="construction-film relative overflow-hidden bg-slate-950 text-white"
  data-construction-film
  data-stages={jsonStages}
>
  <div class="construction-film__pin relative h-[100svh] min-h-[680px]">
    <div class="absolute inset-0 bg-slate-950">
      <img
        class="construction-film__poster absolute inset-0 h-full w-full object-cover object-center"
        src={poster}
        alt="Construction planning and site work"
        loading="lazy"
        decoding="async"
      />
      <video
        class="construction-film__video absolute inset-0 h-full w-full object-cover object-center opacity-0"
        playsinline
        muted
        preload="none"
        aria-hidden="true"
        disablepictureinpicture
        data-video={videoSource}
        poster={poster}
      ></video>
      <div class="absolute inset-0 bg-slate-950/55"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/55 to-slate-950/25"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-slate-950/35"></div>
    </div>

    <div class="container relative z-10 flex h-full items-center py-16 md:py-20">
      <div class="grid w-full grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(320px,430px)] lg:items-end">
        <div class="max-w-3xl">
          <div class="construction-film__eyebrow text-primary text-xs font-semibold tracking-[0.22em] uppercase">
            The SuperBuild Way
          </div>
          <h2 class="construction-film__title mt-5 text-4xl leading-tight font-semibold md:text-6xl">
            From planning to handover.
          </h2>
          <p class="construction-film__copy mt-6 max-w-2xl text-base leading-7 text-white/80 md:text-lg md:leading-8">
            See how a project moves from an idea on paper to a finished space — with the right people, materials, planning, and management at every stage.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <Button label="Talk to SuperBuild" url="/#contact" enable={true} />
            <span class="text-sm text-white/60">Scroll to explore the process</span>
          </div>
        </div>

        <div class="construction-film__stage-panel rounded-2xl border border-white/10 bg-black/25 p-5 backdrop-blur-md">
          <div class="flex items-center justify-between gap-4">
            <div>
              <div class="construction-film__stage-number text-primary text-2xl font-semibold">01</div>
              <div class="construction-film__stage-label mt-1 text-xs font-semibold tracking-[0.18em] text-white/60 uppercase">
                Planning
              </div>
            </div>
            <div class="text-right text-xs text-white/45">SuperBuild process</div>
          </div>

          <h3 class="construction-film__stage-title mt-5 text-xl font-semibold md:text-2xl">
            Start with a clear plan.
          </h3>
          <p class="construction-film__stage-description mt-3 text-sm leading-6 text-white/70">
            We review your needs, drawings, scope, budget, and timeline before work begins.
          </p>

          <div class="mt-6 overflow-hidden rounded-xl border border-white/10">
            <img
              class="construction-film__stage-image h-44 w-full object-cover"
              src={stages[0].image}
              alt="Construction planning"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="mt-6 flex gap-2" aria-hidden="true">
            {stages.map((stage, index) => (
              <span
                class:list={[
                  "construction-film__progress-dot h-1.5 flex-1 rounded-full bg-white/20 transition-all duration-300",
                  index === 0 && "!bg-primary",
                ]}
                data-stage-dot={index}
              ></span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="construction-film__rail pointer-events-none absolute bottom-6 left-1/2 z-10 hidden w-[min(520px,55vw)] -translate-x-1/2 md:block">
      <div class="h-px bg-white/20">
        <i class="bg-primary block h-px origin-left" style="transform:scaleX(0)"></i>
      </div>
    </div>
  </div>

  <div class="construction-film__stage-data hidden" aria-hidden="true">
    {stages.map((stage) => (
      <span>{stage.number}</span>
    ))}
  </div>
</section>

<script>
  const install = () => {
    document.querySelectorAll<HTMLElement>("[data-construction-film]").forEach((section) => {
      if (section.dataset.constructionFilmReady !== undefined) return;
      section.dataset.constructionFilmReady = "";

      const pin = section.querySelector<HTMLElement>(".construction-film__pin");
      const video = section.querySelector<HTMLVideoElement>(".construction-film__video");
      const poster = section.querySelector<HTMLElement>(".construction-film__poster");
      const rail = section.querySelector<HTMLElement>(".construction-film__rail i");
      const stageNumber = section.querySelector<HTMLElement>(".construction-film__stage-number");
      const stageLabel = section.querySelector<HTMLElement>(".construction-film__stage-label");
      const stageTitle = section.querySelector<HTMLElement>(".construction-film__stage-title");
      const stageDescription = section.querySelector<HTMLElement>(".construction-film__stage-description");
      const stageImage = section.querySelector<HTMLImageElement>(".construction-film__stage-image");
      const dots = [...section.querySelectorAll<HTMLElement>("[data-stage-dot]")];

      if (!pin || !video || !poster || !rail || !stageNumber || !stageLabel || !stageTitle || !stageDescription || !stageImage) return;

      const stages = JSON.parse(section.dataset.stages || "[]") as Array<{
        number: string;
        label: string;
        title: string;
        description: string;
        image: string;
      }>;

      let loaded = false;
      let raf = 0;

      const clamp = (value: number) => Math.min(1, Math.max(0, value));

      const loadVideo = () => {
        if (loaded) return;
        loaded = true;
        video.src = video.dataset.video || "";
        video.preload = "auto";
        video.load();
      };

      const updateStage = (progress: number) => {
        if (!stages.length) return;
        const index = Math.min(stages.length - 1, Math.floor(progress * stages.length));
        const stage = stages[index];
        stageNumber.textContent = stage.number;
        stageLabel.textContent = stage.label;
        stageTitle.textContent = stage.title;
        stageDescription.textContent = stage.description;
        if (stageImage.src !== stage.image) stageImage.src = stage.image;
        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle("!bg-primary", dotIndex === index);
        });
      };

      const update = () => {
        const rect = section.getBoundingClientRect();
        const range = Math.max(section.offsetHeight - window.innerHeight, 1);
        const progress = clamp(-rect.top / range);

        updateStage(progress);
        rail.style.transformOrigin = "left";
        rail.style.transform = `scaleX(${progress})`;

        if (loaded && video.duration && Number.isFinite(video.duration) && !video.seeking) {
          const target = Math.max(0, Math.min(video.duration - 0.05, progress * video.duration));
          if (Math.abs(video.currentTime - target) > 0.04) video.currentTime = target;
          video.classList.toggle("opacity-100", true);
          poster.classList.toggle("opacity-0", true);
        }
      };

      const requestUpdate = () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              loadVideo();
              requestUpdate();
            }
          });
        },
        { rootMargin: "300px 0px" },
      );

      observer.observe(section);
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
      video.addEventListener("loadedmetadata", requestUpdate, { once: true });
      video.addEventListener("error", () => {
        video.classList.remove("opacity-100");
        poster.classList.remove("opacity-0");
      });

      requestUpdate();
    });
  };

  document.addEventListener("astro:page-load", install);
  install();
</script>

<style>
  .construction-film {
    min-height: 220svh;
  }

  .construction-film__pin {
    position: sticky;
    top: 0;
  }

  .construction-film__video,
  .construction-film__poster {
    transition: opacity 500ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .construction-film {
      min-height: 100svh;
    }

    .construction-film__pin {
      position: relative;
    }
  }
</style>
