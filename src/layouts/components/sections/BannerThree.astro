---
import { z } from "astro/zod";
import type { Section } from "@/types";
import Button from "@/components/Button.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import OptimizedImage from "../utilities/OptimizedImage.astro";
import type { bannerAgencySectionSchema } from "@/sections.schema";

type BannerThreeType = Section & z.infer<typeof bannerAgencySectionSchema>;
type Props = { content?: BannerThreeType };

const defaultContent = (
  await getEntryCTM("sections", "banner-three", Astro.currentLocale)
)?.data as BannerThreeType;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as BannerThreeType;

const { title, description, gradientBackgroundImage, mapImage, buttons } =
  actualContent;
const backgroundImage = mapImage || "/images/banner/map.svg";
---

<section class="banner-three-section bg-theme-dark relative min-h-[620px] overflow-hidden max-lg:min-h-[600px]">
  {
    backgroundImage && (
      <div class="absolute inset-0 z-0">
        <OptimizedImage
          src={backgroundImage}
          alt="Construction project site"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-slate-950/65"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/85 via-slate-950/55 to-slate-950/30"></div>
      </div>
    )
    }
    {
      gradientBackgroundImage && (
        <div class="pointer-events-none absolute inset-0 z-1 flex">
          <OptimizedImage
            src={gradientBackgroundImage}
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="h-full w-full object-cover opacity-20"
          />
        </div>
      )
    }

    <div class="container relative z-10 flex min-h-[620px] items-center py-28 max-lg:min-h-[600px] max-lg:py-24">
      <div class="banner-three-content max-w-3xl text-left">
        {
          title && (
            <h1
              class="banner-three-title text-display-5 md:text-display-4 lg:text-display-3 xl:text-display-2 leading-tight text-white"
              set:html={markdownify(title)}
            />
          )
        }

        {
          description && (
            <p
              class="banner-three-description text-light mt-6 max-w-2xl text-base leading-7 md:text-lg md:leading-8"
              set:html={markdownify(description)}
            />
          )
        }

        {
          buttons?.length && (
            <div class="banner-three-actions mt-10 flex flex-wrap items-center justify-start gap-4">
              {buttons.map((button) => (
                <Button {...button} />
              ))}
            </div>
          )
        }
      </div>
    </div>
</section>
