---
import { z } from "astro/zod";
import type { Section } from "@/types";
import Button from "@/components/Button.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import OptimizedImage from "../utilities/OptimizedImage.astro";
import type { bannerAgencySectionSchema } from "@/sections.schema";

type BannerThreeType = Section & z.infer<typeof bannerAgencySectionSchema>;
type Props = { content?: BannerThreeType };

const defaultContent = (
  await getEntryCTM("sections", "banner-three", Astro.currentLocale)
)?.data as BannerThreeType;

const actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as BannerThreeType;

const { buttons } = actualContent;

const slides = [
  {
    image: "/images/gallery/1.jpg",
    title: "Building spaces that last.",
    description: "Quality construction, dependable workmanship, and careful project delivery for homes, businesses, and developments.",
  },
  {
    image: "/images/gallery/2.jpg",
    title: "Built with care from plan to completion.",
    description: "We coordinate every stage of construction with practical experience, careful planning, and close attention to detail.",
  },
  {
    image: "/images/gallery/3.jpg",
    title: "Strong work. Professional results.",
    description: "From structural work to finishing, we focus on durable construction and a clean, professional finish.",
  },
];

const jsonSlides = JSON.stringify(slides);
---

<section class="banner-three-section relative min-h-[600px] overflow-hidden bg-slate-950 md:min-h-[640px]" data-hero-carousel data-slides={jsonSlides}>
  <div class="absolute inset-0 z-0 bg-slate-950">
    {slides.map((slide, index) => (
      <div class:list={["banner-three-slide absolute inset-0", index === 0 && "is-active"]} data-hero-slide={index}>
        <OptimizedImage
          src={slide.image}
          alt="Construction project"
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : undefined}
          class="h-full w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-slate-950/20"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/72 via-slate-950/28 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/36 via-transparent to-transparent"></div>
      </div>
    ))}
  </div>

  <div class="container relative z-10 flex min-h-[600px] items-center py-20 md:min-h-[640px] md:py-24">
    <div class="w-full max-w-2xl text-left">
      <div class="banner-three-copy relative min-h-[270px] md:min-h-[300px]">
        {slides.map((slide, index) => (
          <div class:list={["banner-three-copy-slide absolute inset-0 flex flex-col justify-center", index === 0 && "is-active"]} data-hero-copy={index}>
            <h1 class="banner-three-title max-w-xl text-4xl leading-[1.08] font-semibold tracking-tight text-white sm:text-5xl md:text-6xl">{slide.title}</h1>
            <p class="banner-three-description mt-5 max-w-xl text-base leading-7 text-white/88 md:text-lg md:leading-8">{slide.description}</p>
            {buttons?.length && (
              <div class="banner-three-actions mt-7 flex flex-wrap items-center justify-start gap-3 md:mt-8">
                {buttons.map((button) => <Button {...button} />)}
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="mt-6 flex items-center gap-3 md:mt-7">
        <div class="flex items-center gap-2" aria-label="Hero slides">
          {slides.map((_, index) => (
            <button
              type="button"
              class:list={["banner-three-dot h-1.5 w-7 rounded-full bg-white/35 transition-all duration-500", index === 0 && "is-active"]}
              data-hero-dot={index}
              aria-label={`Show slide ${index + 1}`}
              aria-pressed={index === 0 ? "true" : "false"}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const installHero = () => {
    document.querySelectorAll<HTMLElement>("[data-hero-carousel]").forEach((section) => {
      if (section.dataset.heroReady !== undefined) return;
      section.dataset.heroReady = "";

      const slides = [...section.querySelectorAll<HTMLElement>("[data-hero-slide]")];
      const copies = [...section.querySelectorAll<HTMLElement>("[data-hero-copy]")];
      const dots = [...section.querySelectorAll<HTMLButtonElement>("[data-hero-dot]")];
      if (!slides.length || slides.length !== copies.length) return;

      let current = 0;
      let timer = 0;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      const setSlide = (index:number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle("is-active", i === current));
        copies.forEach((copy, i) => copy.classList.toggle("is-active", i === current));
        dots.forEach((dot, i) => {
          dot.classList.toggle("is-active", i === current);
          dot.setAttribute("aria-pressed", i === current ? "true" : "false");
        });
      };

      const restart = () => {
        window.clearInterval(timer);
        if (!reducedMotion.matches) timer = window.setInterval(() => setSlide(current + 1), 6500);
      };

      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          setSlide(index);
          restart();
        });
      });

      slides.slice(1).forEach((slide) => {
        const image = slide.querySelector<HTMLImageElement>("img");
        if (image) {
          const preload = new Image();
          preload.src = image.currentSrc || image.src;
        }
      });

      setSlide(0);
      restart();
    });
  };

  document.addEventListener("astro:page-load", installHero);
  installHero();
</script>

<style>
  .banner-three-slide {
    opacity: 0;
    transform: scale(1.02);
    transition: opacity 900ms ease, transform 6500ms cubic-bezier(.22,1,.36,1);
    pointer-events: none;
  }

  .banner-three-slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .banner-three-copy-slide {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 500ms ease, transform 650ms cubic-bezier(.22,1,.36,1);
    pointer-events: none;
  }

  .banner-three-copy-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .banner-three-dot.is-active {
    width: 2.25rem;
    background: var(--color-primary, currentColor);
    opacity: 1;
  }

  @media (max-width: 767px) {
    .banner-three-copy {
      min-height: 315px;
    }

    .banner-three-copy-slide {
      justify-content: center;
    }

    .banner-three-slide {
      transform: scale(1.015);
    }

    .banner-three-title {
      max-width: 22rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-three-slide,
    .banner-three-copy-slide {
      transition: opacity 250ms ease;
      transform: none;
    }
  }
</style>
